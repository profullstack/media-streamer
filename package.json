    "lightweight-charts": "^5.2.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.47.0",
    "mailparser": "^3.9.28",
    "mpegts.js": "^1.8.2",
    "next": "16.3.5",
    "node-datachannel": "^0.33.4",
    "openai": "^7.18.0",
    "posthog-js": "^1.434.0",
    "puppeteer": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^11.0.0",
    "resend": "^6.28.1",
    "sax": "^1.6.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.10.2",
    "video.js": "^8.24.1",
    "webtorrent": "^3.0.21"

    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sax": "^1.2.7",
    "@types/webtorrent": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.1",
  "pnpm": {
    "overrides": {
      "bittorrent-tracker>undici": "^7.16.0",
      "mpegts.js>webworkify-webpack": "2.1.5",
      "basic-ftp": "^5.2.0"
    }
  }
}
